<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sistema de Escala BK</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{

background:#111827;
color:#fff;

}

/* MENU */

.sidebar{

position:fixed;
left:0;
top:0;
width:270px;
height:100%;
background:#1f2937;
transition:.35s;
overflow-y:auto;
z-index:999;

}

.sidebar.minimizado{

width:75px;

}

.logo{

background:#DC2626;
padding:20px;
font-size:22px;
font-weight:bold;
text-align:center;

}

.menu{

padding:15px;

}

.menu button{

width:100%;
padding:15px;
margin-bottom:10px;
border:none;
border-radius:12px;
background:#374151;
color:#fff;
cursor:pointer;
font-size:15px;
transition:.3s;

}

.menu button:hover{

background:#DC2626;
transform:translateX(6px);

}

.toggle{

position:absolute;
top:15px;
right:-20px;
background:#F59E0B;
color:#111;
width:40px;
height:40px;
border-radius:50%;
display:flex;
justify-content:center;
align-items:center;
cursor:pointer;
font-size:22px;
font-weight:bold;

}

/* CONTEÚDO */

main{

margin-left:270px;
transition:.35s;
padding:25px;

}

main.expandido{

margin-left:75px;

}

header{

background:linear-gradient(45deg,#DC2626,#F59E0B);
padding:25px;
border-radius:20px;

}

header h1{

font-size:32px;

}

header p{

opacity:.9;

}

/* CARDS */

.cards{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-top:25px;
margin-bottom:25px;

}

.card{

background:#1F2937;
padding:20px;
border-radius:18px;
transition:.3s;
box-shadow:0 5px 20px rgba(0,0,0,.3);

}

.card:hover{

transform:translateY(-8px);

}

.card h3{

font-size:35px;
margin-bottom:8px;

}

.card span{

color:#d1d5db;

}

/* TABELA */

table{

width:100%;
border-collapse:collapse;
background:#1F2937;
border-radius:20px;
overflow:hidden;

}

th{

background:#DC2626;
padding:18px;

}

td{

padding:16px;
text-align:center;
border-bottom:1px solid #374151;

}

tr:hover{

background:#2d3748;

}

input{

width:100%;
padding:15px;
margin:25px 0;
border:none;
border-radius:12px;
font-size:16px;

}

/* RESPONSIVO */

@media(max-width:768px){

.sidebar{

left:-270px;

}

.sidebar.ativo{

left:0;

}

main{

margin-left:0;
padding:90px 15px 20px;

}

main.expandido{

margin-left:0;

}

.toggle{

position:fixed;
left:15px;
top:15px;
right:auto;

}

}

</style>

</head>

<body>

<div class="sidebar" id="sidebar">

<div class="logo">

🍔 BK ESCALA

</div>

<div class="toggle" onclick="toggleMenu()">

☰

</div>

<div class="menu">

<button onclick="mostrarTodos()">📅 Escala Completa</button>

<button onclick="mostrar('SEG')">📌 Segunda</button>

<button onclick="mostrar('TER')">📌 Terça</button>

<button onclick="mostrar('QUA')">📌 Quarta</button>

<button onclick="mostrar('QUI')">📌 Quinta</button>

<button onclick="mostrar('SEX')">📌 Sexta</button>

<button onclick="mostrar('SAB')">📌 Sábado</button>

<button onclick="mostrar('DOM')">📌 Domingo</button>

</div>

</div>

<main id="main">

<header>

<h1>Sistema de Escala de Fechamento</h1>

<p>Burger King • Painel Administrativo</p>

</header>

<div class="cards">

<div class="card">

<h3>7</h3>

<span>Dias da Semana</span>

</div>

<div class="card">

<h3>7</h3>

<span>Funcionários</span>

</div>

<div class="card">

<h3>4</h3>

<span>Funções</span>

</div>

<div class="card">

<h3>100%</h3>

<span>Organização</span>

</div>

</div>

<input type="text" id="pesquisa" placeholder="🔍 Pesquisar funcionário..." onkeyup="pesquisar()">

<table>

<thead>

<tr>

<th>Dia</th>
<th>Broiler</th>
<th>Coifa</th>
<th>Mesa</th>
<th>Louça</th>

</tr>

</thead>

<tbody id="corpo">

<tr id="SEG">
<td>SEG</td>
<td>C.Daniel</td>
<td>Thuanny</td>
<td>Matheus</td>
<td>Mariana</td>
</tr>

<tr id="TER">
<td>TER</td>
<td>Mariana</td>
<td>Matheus</td>
<td>Julyan</td>
<td>Tayná</td>
</tr>

<tr id="QUA">
<td>QUA</td>
<td>Tayná</td>
<td>Julyan</td>
<td>C.Daniel</td>
<td>Thuanny</td>
</tr>

<tr id="QUI">
<td>QUI</td>
<td>Matheus</td>
<td>Tayná</td>
<td>Julyan</td>
<td>Daniel</td>
</tr>

<tr id="SEX">
<td>SEX</td>
<td>Julyan</td>
<td>C.Daniel</td>
<td>Tayná</td>
<td>Mariana</td>
</tr>

<tr id="SAB">
<td>SÁB</td>
<td>Thuanny</td>
<td>Mariana</td>
<td>C.Daniel</td>
<td>Matheus</td>
</tr>

<tr id="DOM">
<td>DOM</td>
<td>Sorteio</td>
<td>Sorteio</td>
<td>Sorteio</td>
<td>Sorteio</td>
</tr>

</tbody>

</table>

<br><br>

<div style="display:flex;gap:15px;flex-wrap:wrap;margin-top:25px;">

<button onclick="mostrarTodos()" style="
padding:14px 25px;
border:none;
border-radius:12px;
background:#DC2626;
color:white;
cursor:pointer;
font-size:16px;
font-weight:bold;">
📋 Mostrar Escala Completa
</button>

<button onclick="window.print()" style="
padding:14px 25px;
border:none;
border-radius:12px;
background:#F59E0B;
color:#111;
cursor:pointer;
font-size:16px;
font-weight:bold;">
🖨️ Imprimir / Salvar PDF
</button>

</div>

<footer style="
margin-top:40px;
text-align:center;
color:#9ca3af;
padding:20px;">

Sistema de Escala • Desenvolvido em HTML, CSS e JavaScript

</footer>

</main>

<script>

const sidebar=document.getElementById("sidebar");
const main=document.getElementById("main");

function toggleMenu(){

if(window.innerWidth<=768){

sidebar.classList.toggle("ativo");

}else{

sidebar.classList.toggle("minimizado");
main.classList.toggle("expandido");

}

}

function mostrar(id){

const linhas=document.querySelectorAll("#corpo tr");

linhas.forEach(l=>{

l.style.display="none";
l.style.background="#1F2937";

});

const linha=document.getElementById(id);

linha.style.display="table-row";
linha.style.background="#374151";

if(window.innerWidth<=768){

sidebar.classList.remove("ativo");

}

}

function mostrarTodos(){

const linhas=document.querySelectorAll("#corpo tr");

linhas.forEach(l=>{

l.style.display="table-row";
l.style.background="#1F2937";

});

}

function pesquisar(){

const texto=document
.getElementById("pesquisa")
.value
.toLowerCase();

const linhas=document.querySelectorAll("#corpo tr");

linhas.forEach(linha=>{

const conteudo=linha.innerText.toLowerCase();

if(conteudo.includes(texto)){

linha.style.display="table-row";

}else{

linha.style.display="none";

}

});

}

window.addEventListener("resize",()=>{

if(window.innerWidth>768){

sidebar.classList.remove("ativo");

}

});

/* Relógio */

const relogio=document.createElement("div");

relogio.style.position="fixed";
relogio.style.bottom="20px";
relogio.style.right="20px";
relogio.style.background="#DC2626";
relogio.style.padding="12px 18px";
relogio.style.borderRadius="12px";
relogio.style.fontWeight="bold";
relogio.style.boxShadow="0 5px 20px rgba(0,0,0,.4)";
relogio.style.zIndex="999";

document.body.appendChild(relogio);

setInterval(()=>{

const agora=new Date();

relogio.innerHTML=
agora.toLocaleDateString("pt-BR")+
"<br>"+
agora.toLocaleTimeString("pt-BR");

},1000);

</script>

</body>
</html>
